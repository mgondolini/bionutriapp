    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "studio:create": "tsx scripts/create-studio.ts",
    "client:export": "tsx scripts/client-export.ts",
    "client:delete": "tsx scripts/client-delete.ts",
    "storage:backup": "tsx scripts/storage-backup.ts",
    "seed:files": "tsx scripts/seed-files.ts",
    "notifications:badges": "tsx scripts/notification-badges.tsx"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
