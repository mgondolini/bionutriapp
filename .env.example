# Copia questo file in .env.local e compila i valori. Non committare mai chiavi reali.

# --- Supabase ---
# URL del progetto Supabase (Dashboard > Project Settings > API). Pubblico.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...): pubblica, usabile nel browser; i dati sono protetti dalla Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): bypassa la RLS. SOLO lato server, mai con prefisso NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Notifiche push (Web Push / VAPID) ---
# Genera la coppia di chiavi con: pnpm exec web-push generate-vapid-keys
# Cambiare la coppia invalida tutte le sottoscrizioni esistenti (vedi docs/operativita.md).
# Senza queste variabili l'app funziona, ma le push non partono (errore nei log).
# Chiave pubblica VAPID: usata dal browser per sottoscrivere le notifiche.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Chiave privata VAPID: firma l'invio delle notifiche. SOLO lato server.
VAPID_PRIVATE_KEY=
# Contatto del mittente richiesto dallo standard VAPID (es. mailto:info@esempio.it).
VAPID_SUBJECT=mailto:info@example.com

# --- Applicazione ---
# URL pubblico dell'app (in locale http://localhost:3000), usato per link e redirect.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Slug dello studio mostrato nelle pagine pubbliche (login, manifest). In futuro lo studio
# sarà riconosciuto dal sottodominio o da un dominio personalizzato.
NEXT_PUBLIC_DEFAULT_STUDIO_SLUG=studio-verde
